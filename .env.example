# Postgres (Supabase project, used only as a plain Postgres host — prefer session pooler for broad compatibility)
# Encode special characters in the password: & %26, $ %24, @ %40
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3072"
# Optional, comma-separated: extra origins to trust alongside BETTER_AUTH_URL (e.g. a tunnel host)
BETTER_AUTH_EXTRA_ORIGINS=""

# apps/web (Vite) — must be prefixed VITE_ to be exposed to the browser bundle
VITE_BETTER_AUTH_URL="http://localhost:3072"

PORT=3072
