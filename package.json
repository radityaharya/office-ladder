{
  "name": "office-ladder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env.local run scripts/dev.ts",
    "build": "nx run-many -t build",
    "start": "bun --env-file=.env.local run --cwd apps/server start",
    "lint": "eslint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:watch": "bun run --cwd apps/web vitest",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:push": "bun run --cwd packages/db db:push"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.10.2",
    "eslint": "^9",
    "nx": "^21.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
